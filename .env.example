# VeriTract Email Notification Configuration
# Port to run the website server on
PORT=8080

# Gmail Address where notifications should be sent
NOTIFICATION_EMAIL=info.veritract@gmail.com

# Gmail Sender Account (can be info.veritract@gmail.com)
GMAIL_USER=info.veritract@gmail.com

# Gmail 16-character App Password (generated from Google Account > Security > 2-Step Verification > App Passwords)
# Example: abcd efgh ijkl mnop
GMAIL_APP_PASSWORD=your_16_character_app_password
